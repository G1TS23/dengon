// A et B à portée directe : le message arrive, et seulement chez B.
// synthese/10 §4.3 `direct.ron` (le statut `delivered` viendra avec le vrai
// nœud dengon-core : ici, comportement Inondation).
Scenario(
    nom: "direct",
    description: "A→B connectés, 20 ms de latence",
    noeuds: 2,
    duree_ms: 500,
    liens: [
        (a: 0, b: 1, latence_ms: 20),
    ],
    actions: [
        (a_ms: 10, action: Emettre(noeud: 0, charge: "bonjour")),
    ],
    attendus: [
        Livre(noeud: 1, charge: "bonjour"),
        NonLivre(noeud: 0, charge: "bonjour"),
    ],
)
