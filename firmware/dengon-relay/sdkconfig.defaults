# ---------------------------------------------------------------------------
# sdkconfig.defaults — la configuration du firmware, VERSIONNÉE.
#
# ⚠ PIÈGE N°1 D'ESP-IDF : ce fichier n'est lu QUE lorsque `sdkconfig` n'existe
#   pas encore. Si vous modifiez une ligne ici alors qu'un build a déjà eu lieu,
#   IL NE SE PASSE RIEN — silencieusement, sans le moindre avertissement.
#   Remède : `idf.py fullclean` (ou supprimer `sdkconfig`), puis rebuild.
#
#   Corollaire : `idf.py menuconfig` écrit dans `sdkconfig`, qui n'est PAS
#   versionné. Un réglage fait en menuconfig et non reporté ici est perdu pour
#   tout le monde sauf vous — y compris pour la CI.
#
# Références : docs/synthese/08-relais-esp32.md §2-3 (matériel et pile),
#              docs/powl/03-network-protocol.md §6 (rôle BLE, MTU).
# ---------------------------------------------------------------------------

# --- 1. Cible matérielle : ESP32-WROOM-32E (Xtensa LX6, 4 Mo flash, 0 PSRAM) --
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Table de partitions propre au relais (US-308, partitions.csv) : factory de
# 2 Mo (NimBLE + mbedTLS + libdengon_core.a) et une partition littlefs de
# 256 Ko pour le journal chaîné. Remplace PARTITION_TABLE_SINGLE_APP_LARGE
# (US-114), qui n'avait aucune place pour un système de fichiers.
# ⚠ Carte déjà flashée avec l'ancienne table : `idf.py erase-flash flash`.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- 2. Bluetooth : contrôleur BLE seul, host NimBLE -------------------------
# ⚠ Le host par défaut d'ESP-IDF est Bluedroid (components/bt/Kconfig). Il faut
#   DEUX lignes : activer NimBLE ne désactive pas Bluedroid tout seul. Symptôme
#   si on l'oublie : « host/ble_hs.h: No such file or directory », un message
#   qui ne mentionne jamais Bluedroid.
# NimBLE est le host retenu par la conception : ~40 à 100 Ko de RAM et ~50 % de
# flash de moins que Bluedroid (docs/synthese/10-benchmarks-mvp-tests.md §…).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# BLE seul : le BR/EDR de l'ESP32 ne sert à rien à dengon et coûte ~100 Ko.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3

# --- 3. Rôles NimBLE : les quatre, pour le rôle GATT double (US-220) --------
# docs/powl/03-network-protocol.md §6.1 : chaque nœud est en permanence
# périphérique (annonce + serveur GATT) ET central (scan + client GATT).
# L'US-114 coupait CENTRAL et OBSERVER pour borner son périmètre ; l'US-220 les
# rallume. Sans OBSERVER, ble_gap_disc() n'existe pas au link ; sans CENTRAL,
# ble_gap_connect() non plus — l'erreur tombe à l'édition de liens, pas avant.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# --- 4. GATT / ATT -----------------------------------------------------------
# docs/powl/03 §6.3 : négocier ATT_MTU = 517, repli automatique sur 23.
# BT_NIMBLE_MAX_CONNECTIONS doit rester <= BTDM_CTRL_BLE_MAX_CONN, sinon le host
# réclame au contrôleur plus de liens qu'il n'en a — échec à l'exécution, pas à
# la compilation.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# Un MTU de 517 chaîne plusieurs mbufs par PDU : les 12 blocs par défaut
# suffisent pour un lien, pas pour trois.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24

# --- 5. GAP ------------------------------------------------------------------
# Écrasé à l'exécution par ble_svc_gap_device_name_set(), qui y ajoute le
# suffixe tiré du peerID. Cette valeur ne sert donc qu'avant le premier boot.
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="dengon-relay"

# --- 6. Journalisation -------------------------------------------------------
# INFO au stade du squelette : on veut LIRE dans `idf.py monitor` les UUID
# réellement enregistrés et le MTU réellement négocié — c'est la preuve
# textuelle des critères d'acceptation. À redescendre à WARNING en US-308,
# quand le budget flash comptera.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- 7. Relais dengon (US-308) ----------------------------------------------
# La tâche route de dengon_relay_app.c appelle dengon-core (Rust) : Noise,
# SHA-256 et Ed25519 sur la pile. 6 Ko réservés à sa création ; la tâche
# principale n'exécute que l'initialisation (auto-test Noise compris).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# --- 8. Wi-Fi + HTTPS vers le dashboard (US-309) ----------------------------
# Deux radios sur une antenne : la coexistence logicielle partage le temps
# d'antenne entre BLE (prioritaire, c'est le maillage) et Wi-Fi.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# Budget de tas : WROOM sans PSRAM, NimBLE déjà démarré (~128 Ko libres
# mesurés à l'US-308 avant Wi-Fi). On réduit les tampons Wi-Fi (débit
# inutile ici : quelques Ko de JSON par seconde au plus) et on désactive
# l'agrégation AMPDU, gourmande en RAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# mbedTLS : tampons alloués seulement le temps d'une session TLS (une par
# batch, keep-alive coupé) plutôt que 2 × 16 Ko en permanence.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# On épingle la racine du dashboard : le paquet de ~130 racines publiques ne
# sert à rien et coûte ~60 Ko de flash.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
# IRAM : BLE + Wi-Fi ne tiennent pas dans les 128 Ko d'IRAM de l'ESP32 avec
# les optimisations « chemin chaud en IRAM » du Wi-Fi et de lwIP (dépassement
# de 1,6 Ko constaté au premier build US-309). On les coupe : quelques Ko/s
# de débit en moins, sans importance pour des batchs de JSON.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
