# Copier en `.env` (non commité, voir .gitignore) à côté de ce fichier sur
# le VPS, avant le premier `docker compose up`.

# Secret HMAC pour les JWT courts des nœuds (app/auth.py). Générer avec :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DENGON_DASHBOARD_JWT_SECRET=

# IP publique du VPS (pas de nom de domaine disponible — écart consigné,
# docs/suivi/03-ecarts-conception.md) : nom/SAN du certificat TLS auto-signé
# de Caddy. Sans cette variable, Caddy utilise "localhost" par défaut
# (pratique pour tester en local, PAS pour le VPS réel — Caddy affiche un
# avertissement au démarrage si ce défaut est utilisé, voir
# docker-compose.yml).
CADDY_SITE_ADDRESS=

# Ports hôte publiés par Caddy (voir docker-compose.yml et Caddyfile) — sur
# ce VPS partagé, 80/443 sont déjà occupés par un processus root hors de
# notre contrôle (écart consigné, docs/suivi/03-ecarts-conception.md).
# Optionnels : défaut 8080/8443 si absents. `CADDY_HTTPS_PORT` est aussi lu
# par le Caddyfile (redirection HTTP→HTTPS) — une seule variable pour les
# deux, pas besoin de la répéter ailleurs.
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=

# Second conteneur, dédié à dashboard/web (issue #125) — même logique de
# ports que CADDY_HTTP_PORT/CADDY_HTTPS_PORT ci-dessus, mais un couple
# DISTINCT : les deux instances Caddy publient chacune leurs propres ports
# sur le même hôte. Optionnels : défaut 8081/8444 si absents.
WEB_HTTP_PORT=
WEB_HTTPS_PORT=

# URL publique de l'API (avec son propre port CADDY_HTTPS_PORT ci-dessus),
# injectée dans dashboard/web/config.js au démarrage du conteneur `web` —
# jamais codée en dur dans dashboard/web/index.html. Pas de défaut : cette
# variable dépend directement de CADDY_SITE_ADDRESS/CADDY_HTTPS_PORT
# ci-dessus, une valeur par défaut aurait presque toujours tort sur le VPS
# réel. Exemple : https://51.255.38.214:8443
DENGON_WEB_API_BASE=
